# Copy to .env. The local deterministic model requires no model key.
AGENT_TEST_MODE=1
MODEL_PROVIDER=google
MODEL_ID=gemini-2.5-flash
# GEMINI_API_KEY=
# For Z.AI Coding Plan: MODEL_PROVIDER=zai, MODEL_ID=glm-5.3-flash
# ZAI_API_KEY=
# Azure Foundry: MODEL_PROVIDER=azure, MODEL_ID=gpt-5.6-luna (deployment name)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT/openai/v1
# Accepts the full /responses URL too. Set the key only on the hosted API.
# DEV_LIVE_MODEL=1  # shared local default; explicit --scripted still wins
# Hosted model keys belong only to the API service, never to Box or the executor.
# Production defaults to APP_URL/api/model-gateway; override only with the same gateway's public URL.
# MODEL_GATEWAY_URL=https://companions.build/api/model-gateway
# Development without MODEL_GATEWAY_URL uses direct credentials on the developer's own runtime.
# BOX_API_KEY=
# BOX_TEMPLATE=companions-agent-v0
# API_PORT=4311
# WEB_PORT=4310
# DATABASE_URL=postgres://companions:companions@127.0.0.1:4312/companions
# COMPANIONS_DATA_DIR=.local
# Generated into .local by default; configure encryption explicitly for a persistent installation.
# COMPANIONS_TOKEN=
# COMPANIONS_ENCRYPTION_KEY=
# Local development generates a persistent auth secret. Hosted deployments must set both values.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://companions.example.com
# LOCAL_DEV_EMAIL=developer@companions.build
# The local launcher configures Mailpit. Hosted deployments configure SMTP or Resend.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=companions.build <auth@companions.build>
# Hosted email (explicit provider selection; EMAIL_FROM supersedes SMTP_FROM)
# EMAIL_PROVIDER=resend
# EMAIL_FROM=companions.build <auth@companions.build>
# RESEND_API_KEY=
# Hosted object storage. Local development starts a private MinIO instance when omitted.
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_FILES=companions-files
# S3_REGION=us-east-1

# Curated plugins: set these on API and executor (consent and token refresh).
# Each provider must register
# the exact callback https://companions.build/api/plugins/callback (or APP_URL's origin).
# Linear, Notion, Conductor and Sentry register their OAuth clients dynamically.
# COMPANION_MCP_GITHUB_CLIENT_ID=
# COMPANION_MCP_GITHUB_CLIENT_SECRET=
# COMPANION_MCP_SLACK_CLIENT_ID=
# COMPANION_MCP_SLACK_CLIENT_SECRET=
# COMPANION_MCP_GMAIL_CLIENT_ID=
# COMPANION_MCP_GMAIL_CLIENT_SECRET=
# Gmail also requires Google Workspace Developer Preview access and enabled APIs.
# Provider setup, scopes and acceptance: docs/plugins-production.md

# Optional private beta: exact email addresses, comma separated; no domain wildcards.
# Set the same list on API, executor and worker. An explicitly empty list closes beta access.
# PRIVATE_BETA_EMAILS=owner@example.com

# Hosted subscription and separate usage meters. Leave absent for local development.
# APP_URL=https://companions.build
# STRIPE_SECRET_KEY=
# STRIPE_BASE_PRICE_ID=   # fixed recurring subscription Price, quantity 1
# STRIPE_MODEL_PRICE_ID=  # recurring metered Price linked to the model-token meter
# STRIPE_BOX_PRICE_ID=    # distinct recurring metered Price linked to the Box-seconds meter
# STRIPE_WEBHOOK_SECRET=
# STRIPE_METER_EVENT_NAME=companions_model_tokens
# STRIPE_BOX_METER_EVENT_NAME=companions_box_seconds
# BILLING_TEST_MODE=1  # local-only deterministic subscription/delivery acceptance
